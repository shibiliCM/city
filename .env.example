# =============================================================================
# CityTwin AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local development (without Docker):
MONGODB_URI=mongodb://localhost:27017
# Docker Compose (service name as host):
# MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=citytwin

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Mapbox ───────────────────────────────────────────────────────────────────
# Get from https://account.mapbox.com → Access Tokens
MAPBOX_TOKEN=pk.your-mapbox-public-token

# ─── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Frontend public vars (used by Next.js build) ────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
NEXT_PUBLIC_DEFAULT_CITY_ID=metro-city-01

# ─── Optional tuning ──────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
ENVIRONMENT=development
